# 后端服务器基础 URL (必需)
# 开发环境示例：http://127.0.0.1:8000 或 http://localhost:8000
# 生产环境示例：https://api.narratoai.cn
VITE_API_BASE_URL=http://localhost:8000

# 当前部署的公开站点域名，用于 sitemap、robots、canonical、OG 和 JSON-LD
# narratoai.cn 部署：VITE_SITE_URL=https://narratoai.cn
# narratoai.co 部署：VITE_SITE_URL=https://narratoai.co
VITE_SITE_URL=https://narratoai.cn
